<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/orange_bg"
    android:padding="10dp">

    <!-- Горизонтальная панель: Сложность слева, Описание+Темы справа -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Левая колонка: Сложность + Назад -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/tvDiffTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/difficulty"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnDiffEasy"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="@string/diff_easy"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>

            <Button
                android:id="@+id/btnDiffMedium"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="@string/diff_medium"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>

            <Button
                android:id="@+id/btnDiffHard"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="@string/diff_hard"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>

            <Button
                android:id="@+id/btnDiffExtreme"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="@string/diff_extreme"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <Button
                android:id="@+id/btnSettingsBack"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="@string/back"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <!-- Правая колонка -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <!-- Рекорд + Описание -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDiffRecord"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/record_placeholder"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvDescLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/description_label"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvDiffDesc"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:gravity="top"/>

            </LinearLayout>

            <!-- Разделитель тем -->
            <View
                android:id="@+id/themeDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/black"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"/>

            <!-- Цветовые темы -->
            <TextView
                android:id="@+id/tvThemeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/theme_title"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:id="@+id/themeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="4dp"/>

            <!-- Разделитель ориентации -->
            <View
                android:id="@+id/orientDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/black"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"/>

            <!-- Переключатель ориентации -->
            <TextView
                android:id="@+id/tvOrientTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/orientation_title"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Кнопка горизонтальной ориентации -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp">

                    <Button
                        android:id="@+id/btnOrientLandscape"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text=""
                        android:insetTop="0dp"
                        android:insetBottom="0dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="📱"
                        android:textSize="20sp"
                        android:rotation="270"
                        android:elevation="4dp"
                        android:clickable="false"
                        android:focusable="false"/>

                </FrameLayout>

                <!-- Кнопка вертикальной ориентации -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1">

                    <Button
                        android:id="@+id/btnOrientPortrait"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text=""
                        android:insetTop="0dp"
                        android:insetBottom="0dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="📱"
                        android:textSize="20sp"
                        android:rotation="0"
                        android:elevation="4dp"
                        android:clickable="false"
                        android:focusable="false"/>

                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>